{
  "$id": "https://raw.githubusercontent.com/dhvcc/code-agnostic/main/code_agnostic/spec/schemas/mcp.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "mcp_servers"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "spec_version": { "const": "v1" },
    "mcp_servers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/server"
      }
    }
  },
  "$defs": {
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "client_secret"],
      "properties": {
        "client_id": { "type": "string", "minLength": 1 },
        "client_secret": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "token_endpoint": { "type": "string", "minLength": 1 }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["stdio", "http", "oauth"]
        },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "envFile": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "timeout": { "type": "integer", "minimum": 0 },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "auth": { "$ref": "#/$defs/auth" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "stdio" }
            }
          },
          "then": {
            "required": ["command"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["http", "oauth"]
              }
            }
          },
          "then": {
            "required": ["url"],
            "not": {
              "anyOf": [
                { "required": ["cwd"] },
                { "required": ["envFile"] }
              ]
            }
          }
        }
      ]
    }
  }
}
